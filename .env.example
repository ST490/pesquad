# PESquad Environment Configuration

# Server Port
PORT=3000

# ==========================================
# PESU OAuth2 (Vision2822/pesu-oauth2)
# ==========================================
# OAuth Provider base URL (default: https://pesu-oauth2.vercel.app)
PESU_OAUTH_URL="https://pesu-oauth2.vercel.app"
PESU_OAUTH_CLIENT_ID="pesquad"
PESU_OAUTH_CLIENT_SECRET=""
# PESU_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# ==========================================
# PESU Academy Direct Authentication (Fallback)
# ==========================================
PESU_AUTH_URL="https://pesu-auth.onrender.com"

# ==========================================
# Session Security (iron-session)
# ==========================================
# Secret key for encrypting iron-session cookies (MUST be at least 32 characters long)
SESSION_PASSWORD="pesquad_production_iron_session_secret_password_32_chars_min"

# SIH 2026 Registration Deadline (ISO 8601)
SIH_REGISTRATION_DEADLINE="2026-09-30T23:59:59.000Z"

# Client API Base URL
VITE_API_URL="/api"
